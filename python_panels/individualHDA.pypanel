<?xml version="1.0" encoding="UTF-8"?>
<pythonPanelDocument>
  <!-- This file contains definitions of Python interfaces and the
 interfaces menu.  It should not be hand-edited when it is being
 used by the application.  Note, that two definitions of the
 same interface or of the interfaces menu are not allowed
 in a single file. -->
  <interface name="individualHDA" label="Individual HDA" icon="MISC_python" showNetworkNavigationBar="false" help_url="">
    <script><![CDATA[########################################################################
# Copyright 2020. (Seongcheol Jeon) all rights reserved.
#
# author:           SeongcheolJeon
# email:            saelly55@gmail.com
# description:      Individual HDA
#
# https://github.com/seongcheoljeon/IndividualHDA
########################################################################

from __future__ import annotations

import sys
from pathlib import Path
from typing import Any
import hou

package_root = hou.getenv('IHDA_ROOT')
root = (Path(package_root) if package_root else
        Path(hou.getenv('HOUDINI_USER_PREF_DIR')) / 'scripts' / 'python' / 'IndividualHDA')
if not (root / 'main.py').is_file():
    raise RuntimeError(f'Individual HDA installation not found: {root}. Check IHDA_ROOT in the Houdini package.')
if str(root) not in sys.path:
    sys.path.insert(0, str(root))

iHDA: Any = None

def onCreateInterface() -> Any:
    global iHDA
    if not hou.isUIAvailable():
        raise RuntimeError('Individual HDA requires the Houdini graphical interface')
    if hou.applicationVersion()[0] < 21:
        raise RuntimeError('Individual HDA requires Houdini 21 or later (Qt 6 / PySide6)')
    # Imported here so the version message above is shown before PySide6 is loaded.
    from main import IndividualHDA
    iHDA = IndividualHDA(embedded=True)
    return iHDA

def onDestroyInterface() -> None:
    global iHDA
    if iHDA is not None:
        iHDA.shutdown_for_host()
    iHDA = None
]]></script>
    <includeInToolbarMenu menu_position="104" create_separator="false"/>
    <help><![CDATA[]]></help>
  </interface>
</pythonPanelDocument>
